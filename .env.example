# Set DEBUG to include diagnostic logs and the carrier username.
LOG_LEVEL=INFO

# Fill in carrier settings in your local .env file. Do not commit credentials.
# Username for your carrier web account; ask your administrator if needed.
CARRIER_USERNAME=
# Password for your carrier web account; ask your administrator if needed.
CARRIER_PASSWORD=
# Obtain the API Basic credential from your administrator.
# Use only the encoded credential, without the Basic prefix.
CARRIER_BASIC_AUTH=
# Obtain the site domain from the carrier web portal or your administrator.
CARRIER_SITE_DOMAIN=
# Obtain the required API scope from the carrier API documentation or your administrator.
CARRIER_SCOPE=

# Obtain the login endpoint from the carrier web portal or your administrator.
CARRIER_LOGIN_URL=
# Obtain the access token endpoint from the carrier web portal or your administrator.
CARRIER_TOKEN_URL=
# Obtain the home data endpoint from the carrier web portal or your administrator.
CARRIER_HOME_URL=
