# Set DEBUG to include diagnostic logs without credentials.
LOG_LEVEL=INFO

# Required for API startup; unique random key per person. No Bearer prefix.
# Example format: API_KEYS='{"alice":"<random-key>","bob":"<another-random-key>"}'
API_KEYS=

# Fill in Telcel settings in your local .env file. Do not commit credentials.
# Username for your Telcel web account; ask your administrator if needed.
TELCEL_USERNAME=
# Password for your Telcel web account; ask your administrator if needed.
TELCEL_PASSWORD=
# Obtain the API Basic credential from your administrator.
# Use only the encoded credential, without the Basic prefix.
TELCEL_BASIC_AUTH=
# Obtain the site domain from the Telcel web portal or your administrator.
TELCEL_SITE_DOMAIN=
# Obtain the required API scope from the Telcel API documentation or your administrator.
TELCEL_SCOPE=

# Obtain the login endpoint from the Telcel web portal or your administrator.
TELCEL_LOGIN_URL=
# Obtain the access token endpoint from the Telcel web portal or your administrator.
TELCEL_TOKEN_URL=
# Obtain the home data endpoint from the Telcel web portal or your administrator.
TELCEL_HOME_URL=
