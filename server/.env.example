# CLI logging level: INFO or DEBUG.
LOG_LEVEL=INFO

# Required for API startup: unique random key per person, without the Bearer prefix.
# Example: API_KEYS='{"alice":"<random-key>","bob":"<another-random-key>"}'
API_KEYS=

# Telcel phone number.
TELCEL_USERNAME=
# Telcel account password.
TELCEL_PASSWORD=
# Optional fallback if web-client discovery fails; encoded credential without Basic prefix.
TELCEL_BASIC_AUTH=
# Optional OIDC overrides; leave unset to use the web-client defaults.
# TELCEL_OIDC_CLIENT_ID=31f419f6-5446-4e7e-a275-daf60f568698
# TELCEL_OIDC_REDIRECT_URI=https://mtl.smapps.mx:1333/sso/callback

# Bait phone number.
BAIT_PHONE=
# Bait consumption API service key.
BAIT_SERVICE_KEY=
